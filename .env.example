# ---------------------------------------------------------------------------
# WitCar environment (masterplan §20). Validated by src/lib/env.ts (zod).
# Copy to .env.local for local development. NEVER commit real values.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Production: Supabase Postgres via the pooler (transaction mode, port 6543).
DATABASE_URL=
# Local dev without Supabase: in-process Postgres (PGlite). Optional data dir:
# WITCAR_DB=pglite
# PGLITE_DATA_DIR=.pglite

# --- Auth -------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only
# Local dev without Supabase (instant login, no e-mail):
# WITCAR_AUTH=dev
# >= 32 chars, used to sign the dev session cookie
WITCAR_SESSION_SECRET=
# Only for CI/E2E production builds that use PGlite/dev auth:
# WITCAR_ALLOW_DEV_BACKEND=1

# --- Stripe (TEST MODE until owner writes GO LIVE) --------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# A sk_live_ key is refused unless this is exactly GO_LIVE:
# WITCAR_STRIPE_LIVE=

# Cache and rate limits use the Postgres table api_cache (no extra service, D-010).

# --- Data providers (all calls server-side via cache proxy) -----------------
# Defaults with a real database are free AND allowed commercially:
#   weather met-norway (+ Nominatim city search), fx ecb, stocks off.
# met-norway | open-meteo | mock  (open-meteo needs its paid API key commercially, D-007)
WEATHER_PROVIDER=
WEATHER_API_KEY=
# Contact for the User-Agent that MET Norway and Nominatim require (e-mail or URL)
PROVIDER_CONTACT=
# ecb | mock  (ECB euro reference rates, D-031)
FX_PROVIDER=
# finnhub | mock | off  (no free commercial stock source exists -> off, D-008)
STOCKS_PROVIDER=
STOCKS_API_KEY=
# coinmarketcap | coingecko | mock  (D-009). Free Basic key: https://coinmarketcap.com/api/
CRYPTO_PROVIDER=
CMC_API_KEY=
# CoinGecko only (Demo plan is not licensed for commercial use):
CRYPTO_API_KEY=
CRYPTO_API_PLAN=demo

# Daily cost brakes per provider (upstream calls/day)
PROVIDER_DAILY_LIMIT_STOCKS=800
PROVIDER_DAILY_LIMIT_WEATHER=5000
PROVIDER_DAILY_LIMIT_CRYPTO=450
PROVIDER_DAILY_LIMIT_GEO=2000
PROVIDER_DAILY_LIMIT_FX=100

# --- Google Calendar (Phase 5, not used yet) --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
